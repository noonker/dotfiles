#version 130
// Le Soleil, XVIIII of the Tarot de Marseille, re-cut at the size of the screen from the
// deck in cards/.  It's printed the way the card was: a black keyblock, then stencilled
// color that misses its mark.  The sun keeps real time: it comes up over the wall at
// sunrise, crosses the sky, and sets behind the wall when the theme turns to night.
//
// shaderbg bakes the print (BAKE) every so often, however long that takes, and only the
// rays and the falling drops are drawn on every frame, in between its two layers.
#define PI 3.14159265

#ifdef VERTEX
#define SHARED flat out
#else
#define SHARED flat in
#endif

const vec3 PAPER = vec3(%bg.vec3%);
const vec3 AGED = vec3(%bg-alt.vec3%);
const vec3 INK = vec3(%fg.vec3%);
const vec3 ROUGE = vec3(%rouge.vec3%);
const vec3 COBALT = vec3(%sky.vec3%);
const vec3 OCHRE = vec3(%ochre.vec3%);
const vec3 OLIVE = vec3(%olive.vec3%);
const vec3 MOSS = vec3(%moss.vec3%);

const float R_DISC = 0.15;
const float R_RING = 0.192;
const float R_TIPS = 0.392;
const float WALL_TOP = -0.30;
const float WALL_FOOT = -0.438;
const float NOON_HEIGHT = 0.085;
const float FRAME_TOP = 0.460;          // just under the bar
const float FRAME_FOOT = -0.486;
const float FRAME_MARGIN = 0.014;
const vec2 MISREGISTER = vec2(0.0034, -0.0026);

SHARED vec2 SUN;
SHARED float LOW;      // 1 with the sun on the horizon, 0 at noon

#ifdef VERTEX
// Where the sun is: left of center before solar noon and right after, as if facing south.
// Its climb is normalized to the day, so that it always rises over the wall and clears it.
void sceneSetup() {
    float lat = radians(%latitude%);
    float d = iEpoch.x + iEpoch.y;
    float anomaly = radians(357.528 + 0.9856003 * d);
    float lambda = radians(280.460 + 0.9856474 * d + 1.915 * sin(anomaly) + 0.020 * sin(2.0 * anomaly));
    float obliquity = radians(23.439);
    float dec = asin(sin(obliquity) * sin(lambda));
    float ra = atan(cos(obliquity) * sin(lambda), cos(lambda));
    // A float can't hold 360.98 * d, so the whole turns are dropped before adding.
    float gmst = mod(280.46061837 + 0.98564736629 * iEpoch.x, 360.0) + 360.98564736629 * iEpoch.y;
    float hour = mod(radians(gmst + %longitude%) - ra + PI, 2.0 * PI) - PI;
    float cosSet = (sin(radians(-0.83)) - sin(lat) * sin(dec)) / (cos(lat) * cos(dec));
    float set = acos(clamp(cosSet, -1.0, 1.0));
    float climb = clamp((cos(hour) - cosSet) / (1.0 - cosSet), 0.0, 1.0);
    SUN = vec2(0.36 * iResolution.x / iResolution.y * clamp(hour / set, -1.0, 1.0),
               WALL_TOP + (NOON_HEIGHT - WALL_TOP) * pow(climb, 0.8));
    LOW = 1.0 - climb;
}
#else

%background-common%
#ifdef BAKE

// The face, traced from the scan of the card.  q is in units of the disc's radius.
float face(vec2 q) {
    float d = 1e3;
#define K(ax, ay, bx, by, cx, cy, w0, w1) d = min(d, cut(q, vec2(ax, ay), vec2(bx, by), vec2(cx, cy), (w0) * 1.3, (w1) * 1.3));
    // Its left eye, on our left.
    K(-0.585,  0.250, -0.360,  0.345, -0.090,  0.222, 0.006, 0.022)
    K(-0.500,  0.185, -0.320,  0.235, -0.155,  0.190, 0.004, 0.011)
    K(-0.520,  0.115, -0.390,  0.145, -0.262,  0.132, 0.008, 0.024)
    K(-0.246,  0.135, -0.200,  0.140, -0.150,  0.132, 0.006, 0.015)
    K(-0.580,  0.030, -0.490, -0.055, -0.355, -0.090, 0.008, 0.016)
    K(-0.355, -0.090, -0.220, -0.060, -0.125,  0.040, 0.018, 0.012)
    K(-0.505,  0.190, -0.590,  0.030, -0.530, -0.125, 0.006, 0.030)
    K(-0.100,  0.150, -0.105,  0.030, -0.170, -0.130, 0.008, 0.016)
    d = min(d, length((q - vec2(-0.355, 0.074)) / vec2(1.14, 1.0)) - 0.07);
    // Its right eye.
    K( 0.135,  0.265,  0.300,  0.340,  0.485,  0.310, 0.006, 0.018)
    K( 0.480,  0.230,  0.560,  0.200,  0.615,  0.120, 0.004, 0.011)
    K( 0.220,  0.215,  0.330,  0.250,  0.450,  0.245, 0.004, 0.011)
    K( 0.170,  0.270,  0.095,  0.070,  0.165, -0.130, 0.006, 0.028)
    K( 0.260,  0.115,  0.400,  0.140,  0.620,  0.105, 0.008, 0.023)
    K( 0.150,  0.000,  0.290, -0.100,  0.420, -0.095, 0.008, 0.016)
    K( 0.420, -0.095,  0.540, -0.040,  0.610,  0.100, 0.014, 0.013)
    K( 0.617,  0.110,  0.575, -0.020,  0.505, -0.180, 0.012, 0.018)
    d = min(d, length((q - vec2(0.355, 0.066)) / vec2(1.12, 1.0)) - 0.072);
    // The mark beside it and the nick in the forehead, which the cutter left in.
    d = min(d, (abs(q.x - 0.693) + abs(q.y - 0.058) - 0.034) * 0.75);
    K( 0.000,  0.565,  0.018,  0.550,  0.036,  0.535, 0.004, 0.009)
    // The nose.
    K(-0.100, -0.190, -0.175, -0.265, -0.100, -0.315, 0.008, 0.024)
    K(-0.100, -0.315, -0.050, -0.345, -0.015, -0.415, 0.014, 0.015)
    K(-0.015, -0.415,  0.050, -0.375,  0.085, -0.310, 0.014, 0.015)
    K( 0.085, -0.310,  0.180, -0.290,  0.160, -0.225, 0.012, 0.016)
    K( 0.160, -0.225,  0.125, -0.200,  0.090, -0.190, 0.012, 0.005)
    // The mouth, shut, between its two lines.
    K(-0.220, -0.495, -0.225, -0.565, -0.215, -0.635, 0.006, 0.016)
    K( 0.145, -0.505,  0.160, -0.565,  0.150, -0.630, 0.004, 0.010)
    K(-0.170, -0.585, -0.120, -0.520, -0.065, -0.490, 0.006, 0.013)
    K(-0.065, -0.490,  0.000, -0.515,  0.068, -0.495, 0.012, 0.009)
    K( 0.068, -0.495,  0.110, -0.515,  0.145, -0.550, 0.012, 0.007)
    K(-0.140, -0.565,  0.000, -0.535,  0.120, -0.565, 0.004, 0.008)
    K(-0.170, -0.540, -0.090, -0.620,  0.000, -0.640, 0.005, 0.013)
    K( 0.000, -0.640,  0.090, -0.610,  0.145, -0.550, 0.012, 0.008)
    // The chin.
    K(-0.110, -0.770, -0.055, -0.720, -0.020, -0.690, 0.004, 0.012)
    K(-0.020, -0.690,  0.040, -0.720,  0.100, -0.770, 0.012, 0.004)
#undef K
    return d;
}

// The short cuts running in from the rim, longest and heaviest across the brow.
float rimCuts(vec2 q) {
    const float SIZE = 2.0 * PI / 66.0;
    float r = length(q);
    float a = atan(q.y, q.x);
    float id = floor(a / SIZE + 0.5);
    float h = hash(vec2(id, 5.0));
    float brow = smoothstep(0.25, 0.95, sin(id * SIZE));
    float len = mix(0.09, 0.19, h) + 0.13 * brow;
    float u = clamp((1.0 - r) / len, 0.0, 1.0);
    float x = (a - id * SIZE) * r + (1.0 - r) * (h - 0.5) * 0.35;
    return max(abs(x) - mix(0.021 + 0.008 * brow, 0.002, u), (1.0 - r) - len);
}

// · LE · SOLEIL ·
float title(vec2 p) {
    float d = 1e3;
    p += vec2(2.85, 0.0);
    d = min(d, length(p - vec2(-0.62, 0.5)) - 0.09);
    d = min(d, letterL(p)); p.x -= 0.82;
    d = min(d, letterE(p)); p.x -= 1.04;
    d = min(d, length(p - vec2(-0.22, 0.5)) - 0.09);
    d = min(d, letterS(p)); p.x -= 0.76;
    d = min(d, letterO(p)); p.x -= 0.86;
    d = min(d, letterL(p)); p.x -= 0.82;
    d = min(d, letterE(p)); p.x -= 0.76;
    d = min(d, letterI(p)); p.x -= 0.50;
    d = min(d, letterL(p));
    return min(d, length(p - vec2(0.92, 0.5)) - 0.09);
}

vec3 stock(vec2 uv, vec2 frame) {
    float blotch = fbm(uv * 2.7 + 3.0);
    vec3 color = mix(PAPER, AGED, smoothstep(0.42, 0.78, blotch) * 0.55);
    // Laid paper: the mould's fine wires and, far apart, its chain lines.
    float laid = 0.5 + 0.5 * sin(uv.y * 2.0 * PI * 215.0 + 2.0 * noise(uv * 9.0));
    float chain = smoothstep(0.012, 0.0, abs(fract(uv.x * 11.0) - 0.5) / 11.0 * 8.0);
    float fibre = noise(vec2(uv.x * 420.0, uv.y * 40.0));
    color *= 1.0 - 0.0075 * laid - 0.012 * chain - 0.012 * fibre;
    // Foxing: a few rust specks.
    vec2 cell = floor(uv * 34.0);
    float h = hash(cell + 41.0);
    if (h > 0.968) {
        vec2 at = (cell + 0.5 + (vec2(hash(cell + 3.0), hash(cell + 9.0)) - 0.5) * 0.7) / 34.0;
        float size = mix(0.0005, 0.0017, hash(cell + 14.0));
        color = mix(color, color * vec3(0.84, 0.72, 0.58),
                    smoothstep(size * 1.4, size * 0.4, length(uv - at)) * 0.55);
    }
    // Everything darkens a little toward the edge of the sheet.
    float edge = min(frame.x, frame.y);
    return mix(color * vec3(0.975, 0.962, 0.93), color, smoothstep(0.0, 0.05, edge));
}

void bakeImage(out vec4 back, out vec4 front, in vec2 fragCoord) {
    float aspect = iResolution.x / iResolution.y;
    float side = 0.5 * aspect - FRAME_MARGIN;
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    float aa = 0.8 / iResolution.y;

    // The knife wanders; the stencil was laid down later and doesn't quite follow.
    vec2 wander = (vec2(noise(uv * 7.0), noise(uv * 7.0 + 31.0)) - 0.5) * 0.0028
                + (vec2(noise(uv * 61.0), noise(uv * 61.0 + 17.0)) - 0.5) * 0.0008;
    vec2 p = uv + wander;
    vec2 c = uv + wander * 0.4 + MISREGISTER;

    vec3 paper = stock(uv, vec2(side - abs(uv.x), min(FRAME_TOP - uv.y, uv.y - FRAME_FOOT)));
    // Dry brush, for the drops and the rays to borrow; long streaks along x.
    float brush = fbm(vec2(uv.x * 7.0, uv.y * 120.0) + 11.0);
    // Toward dawn and dusk a thin wash goes on above the wall.
    float dusk = LOW * LOW * smoothstep(0.34, WALL_TOP, uv.y) * (0.75 + 0.5 * (fbm(vec2(uv.x * 4.0, uv.y * 70.0)) - 0.5));
    back = vec4(paper * mix(vec3(1.0), mix(OCHRE, ROUGE, 0.3 * smoothstep(0.1, WALL_TOP, uv.y)), 0.4 * dusk), brush);

    vec3 color = paper;
    float cover = 0.0;
    float keyblock = 1e3;
    // Pigment settles into the paper's tooth, and a loaded brush leaves some streaks.
    float tooth = noise(uv * 900.0) * 0.5 + noise(uv * 470.0 + 9.0) * 0.5;
    float swell = fbm(uv * 13.0 + 5.0);
    float wash = 0.93 + 0.11 * (tooth - 0.5) + 0.16 * (swell - 0.5);

    // The sun: ochre ring, olive disc, and the block's face on top.
    vec2 s = p - SUN, sc = c - SUN;
    float rs = length(s), rc = length(sc);
    if (rs < R_RING * 1.1) {
        float ringBrush = (fbm(vec2(atan(sc.y, sc.x) * 44.0, rc * 16.0)) - 0.5) * 0.0065;
        float ring = fill(rc - R_RING + ringBrush, aa);
        color = mix(color, paper * mix(vec3(1.0), OCHRE, wash), ring);
        cover = max(cover, ring);
        vec2 q = s / R_DISC;
        float brow = smoothstep(0.72, 0.98, rc / R_DISC) * smoothstep(0.0, 0.7, sc.y / R_DISC);
        vec3 discColor = mix(OLIVE, MOSS, brow * 0.8) * (0.985 + 0.13 * (tooth - 0.5) + 0.12 * (swell - 0.5));
        color = mix(color, paper * discColor, fill(rc - R_DISC, aa));
        keyblock = min(keyblock, abs(rs - R_DISC) - 0.0046);
        if (rs < R_DISC) {
            keyblock = min(keyblock, rimCuts(q) * R_DISC);
            keyblock = min(keyblock, face(q) * R_DISC);
        }
        // The wall and the frame stand in front of it.
        keyblock = max(keyblock, max(WALL_TOP - p.y, abs(p.x) - side));
    }

    // The wall.
    if (uv.y < WALL_TOP + 0.01 && uv.y > WALL_FOOT - 0.01) {
        const float COURSE = 0.0252, BRICK = 0.105, COPING = 0.0115;
        float wall = fill(p.y - WALL_TOP, aa);
        float below = WALL_TOP - p.y - COPING;
        float row = floor(below / COURSE);
        vec2 at = vec2(p.x / BRICK + 0.5 * mod(row, 2.0) + 0.17 * hash(vec2(row, 7.0)), below / COURSE - row);
        vec2 id = vec2(floor(at.x), row);
        float h = hash(id + 3.0);

        // Colored course by course, as on the card, by a brush that wasn't always loaded.
        vec3 pigment = row < 1.0 ? MOSS : row < 2.0 ? ROUGE : row < 3.0 ? OCHRE : row < 4.0 ? ROUGE : MOSS;
        float streak = fbm(vec2(c.x * 16.0, c.y * 210.0) + id * 3.0);
        float density = wash * (0.9 + 0.1 * h) + 0.22 * (streak - 0.5);
        if (h > 0.93) density *= 0.3;
        vec3 brickColor = paper * mix(vec3(1.0), pigment, density);
        float cap = fill(c.y - WALL_TOP, aa) * smoothstep(-COPING - aa, -COPING + aa, c.y - WALL_TOP);
        color = mix(color, brickColor, wall);
        color = mix(color, paper * mix(vec3(1.0), OCHRE, wash), cap);
        cover = max(cover, wall);

        keyblock = min(keyblock, max(abs(p.y - WALL_TOP) - 0.0026, abs(p.x) - side));
        keyblock = min(keyblock, max(abs(p.y - WALL_TOP + COPING) - 0.0012, abs(p.x) - side));
        if (below > 0.0 && p.y > WALL_FOOT && abs(p.x) < side) {
            float course = abs(fract(below / COURSE + 0.5) - 0.5) * COURSE - 0.0011;
            float joint = abs(fract(at.x + 0.5) - 0.5) * BRICK - (0.0009 + 0.0005 * h);
            keyblock = min(keyblock, min(course, joint));
            // A few bricks have some shading cut into their right-hand end.
            if (h < 0.22) {
                vec2 shade = vec2((1.0 - fract(at.x)) * BRICK, at.y * COURSE);
                float hatch = abs(fract((shade.x - shade.y) / 0.0064 + 0.5) - 0.5) * 0.0064 - 0.0005;
                keyblock = min(keyblock, max(hatch, shade.x - 0.012 - 0.022 * hash(id + 4.0)));
            }
        }
    }

    // The foot of the card: its name, in a caption box.
    if (uv.y < WALL_FOOT + 0.006) {
        float box = fill(p.y - WALL_FOOT, aa);
        color = mix(color, paper, box);
        cover = max(cover, box);
        keyblock = min(keyblock, max(abs(p.y - WALL_FOOT) - 0.0026, abs(p.x) - side));
        const float HEIGHT = 0.0285;
        vec2 q = (p - vec2(0.0, 0.5 * (WALL_FOOT + FRAME_FOOT) - 0.5 * HEIGHT)) / HEIGHT;
        keyblock = min(keyblock, title(q) * HEIGHT);
    }

    // The margin and the ruled frame, whose lines overshoot the corners a little.
    vec2 corner = vec2(abs(p.x) - side, p.y > 0.0 ? p.y - FRAME_TOP : FRAME_FOOT - p.y);
    float outside = fill(-max(corner.x, corner.y), aa);
    color = mix(color, paper, outside);
    cover = max(cover, outside);
    float overshoot = 0.007;
    keyblock = min(keyblock, max(abs(corner.x) - 0.0029, corner.y - overshoot));
    keyblock = min(keyblock, max(abs(corner.y) - 0.0029, corner.x - overshoot));
    keyblock = min(keyblock, max(abs(corner.x + 0.0088) - 0.0009, corner.y - overshoot));
    keyblock = min(keyblock, max(abs(corner.y + 0.0088) - 0.0009, corner.x - overshoot));

    // The block prints black and sharp, with an edge just rough enough to have been cut.
    float rough = (noise(uv * 230.0) - 0.5) * 0.0006 + (noise(uv * 700.0) - 0.5) * 0.0004;
    float ink = fill(keyblock + rough, aa);
    float alpha = cover + ink - cover * ink;
    front = vec4(color * cover * (1.0 - ink) + INK * ink, alpha);
}

#else

// A drop with its point toward +y, built from a circle and its tangents.
float dropShape(vec2 p) {
    const float R = 0.0205, H = 0.042, K = R / H, S = 0.8739;   // S is sqrt(1 - K * K)
    p.x = abs(p.x) * (1.0 + 0.55 * smoothstep(0.0, H, p.y));   // the sides curve in
    float along = dot(p, vec2(-K, S));
    if (along < 0.0) return length(p) - R;
    if (along > S * H) return length(p - vec2(0.0, H));
    return dot(p, vec2(S, K)) - R;
}

vec3 paintDrops(vec3 color, vec2 uv, float aa) {
    const float CELL = 0.172;
    float fallen = iTime * 0.0042;
    float row = floor((uv.y + fallen) / CELL);
    float shift = 0.5 * mod(row, 2.0);
    vec2 id = vec2(floor(uv.x / CELL + shift), row);
    float h = hash(id + 7.0);
    if (h < 0.28) return color;

    vec2 jitter = (vec2(hash(id + 1.0), hash(id + 2.0)) - 0.5) * vec2(0.075, 0.07);
    vec2 center = vec2((id.x + 0.5 - shift) * CELL, (row + 0.5) * CELL - fallen) + jitter;
    center.x += 0.0065 * sin(iTime * 0.21 + h * 40.0);
    vec2 toSun = SUN - center;
    float away = length(toSun);
    // They come out of the rays and go back in, rather than crossing them.
    float size = smoothstep(R_TIPS * 0.94, R_TIPS * 1.2, away) * mix(0.85, 1.15, hash(id + 5.0));
    if (size < 0.02) return color;

    vec2 dir = normalize(vec2(0.0, 1.0) + 0.6 * toSun / away);
    vec2 d = (uv - center) / size;
    vec2 local = vec2(dot(d, vec2(dir.y, -dir.x)), dot(d, dir));
    local.x += 3.0 * local.y * local.y * (hash(id + 6.0) - 0.5);    // no two are straight

    // Some took a color, and that color never quite lands on its outline.
    float which = hash(id + 8.0);
    if (which < 0.82) {
        vec3 pigment = which < 0.34 ? ROUGE : which < 0.58 ? COBALT : OCHRE;
        vec2 off = (vec2(hash(id + 9.0), hash(id + 10.0)) - 0.5) * 0.013;
        float brush = texture(iChannel0, 0.7 * uv + vec2(h, which)).a;
        float cover = fill(dropShape(local + off) + (brush - 0.5) * 0.005, aa / size);
        color *= mix(vec3(1.0), pigment, cover * (0.8 + 0.3 * brush));
    }
    // A heavy line on one side and a hairline on the other.
    float outer = dropShape(local), inner = dropShape((local + vec2(0.0013, -0.0005)) * 1.14);
    float ink = fill(max(outer, -inner), aa / size);
    return mix(color, INK, ink);
}

vec3 paintRays(vec3 color, vec2 uv, float aa) {
    vec2 s = uv - SUN;
    float r = length(s);
    if (r < R_RING * 0.9 || r > R_TIPS + 0.02) return color;
    const float SIZE = 2.0 * PI / 16.0;
    vec2 c = s + MISREGISTER;
    float angle = atan(s.y, s.x) + iTime * 0.0065;

    // The wavy rays, between the straight ones: painted through the stencil with no block
    // to follow, and the only part of the sun that isn't still.
    {
        float a = angle + 0.5 * SIZE;
        float id = floor(a / SIZE + 0.5);
        float h = fract(id * 0.618 + 0.31);
        float u = (r - R_RING) / mix(0.118, 0.176, h);
        if (u < 1.0) {
            float t = max(u, 0.0);
            float x = (a - id * SIZE) * r + 0.021 * pow(t, 1.25) * sin(t * 6.6 - iTime * 0.36 + id * 2.4);
            float half_ = 0.0335 * pow(1.0 - t, 0.85);
            vec2 tc = vec2(r * 1.3 + id * 0.13, a * 0.21 + 0.3);
            float brush = texture(iChannel0, tc).a;
            float cover = fill(abs(x) - half_ + (brush - 0.5) * 0.006, aa);
            color *= mix(vec3(1.0), ROUGE, cover * (0.9 + 0.2 * smoothstep(0.3, 0.6, brush)));
        }
    }

    // The straight rays: ochre, and outlined by the block a little past the ochre's end.
    {
        float id = floor(angle / SIZE + 0.5);
        float h = fract(id * 0.754 + 0.17);
        float len = mix(0.16, 0.2, h);
        float u = (r - R_RING) / len;
        if (u < 1.0) {
            float x = (angle - id * SIZE) * r;
            float half_ = 0.0272 * (1.0 - max(u, 0.0));
            float xc = (angle - id * SIZE) * length(c) + MISREGISTER.y * 0.6;
            float brush = texture(iChannel0, vec2(r * 1.1 + id * 0.17, angle * 0.17 + 0.61)).a;
            float cover = fill(abs(xc) - half_ * 0.98 + (brush - 0.5) * 0.004, aa) * step(u, 0.93);
            color *= mix(vec3(1.0), OCHRE, cover * (0.86 + 0.24 * smoothstep(0.3, 0.6, brush)));
            // Heavier on the side away from the light.
            float line = abs(abs(x + 0.0006) - half_) - mix(0.0021, 0.0011, u);
            float crease = max(abs(x) - 0.0007, u - 0.62 - 0.25 * h);
            color = mix(color, INK, fill(min(line, crease), aa));
        }
    }
    return color;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    ivec2 px = ivec2(fragCoord);
    vec4 back = texelFetch(iChannel0, px, 0), front = texelFetch(iChannel1, px, 0);
    if (iBakeMix < 1.0) {
        back = mix(texelFetch(iChannel2, px, 0), back, iBakeMix);
        front = mix(texelFetch(iChannel3, px, 0), front, iBakeMix);
    }
    vec3 color = back.rgb;
    if (front.a < 0.998) {
        vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
        float aa = 0.8 / iResolution.y;
        color = paintDrops(color, uv, aa);
        color = paintRays(color, uv, aa);
    }
    fragColor = vec4(front.rgb + color * (1.0 - front.a), 1.0);
}

#endif
#endif
