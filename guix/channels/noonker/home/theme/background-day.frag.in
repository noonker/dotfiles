// Tarot de Marseille: Le Soleil, as a hand-stencilled woodcut.
#define PI 3.14159265

const vec3 PAPER = vec3(%bg.vec3%);
const vec3 AGED = vec3(%bg-high.vec3%);
const vec3 INK = vec3(%fg.vec3%);
const vec3 VERMILION = vec3(%accent.vec3%);
const vec3 COBALT = vec3(%sky.vec3%);
const vec3 YELLOW = vec3(%sun.vec3%);

const vec2 SUN_CENTER = vec2(0.0, 0.02);
const float SUN_RADIUS = 0.15;
const float WALL_TOP = -0.36;

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

float fbm(vec2 p) {
    float value = 0.0, amplitude = 0.5;
    for (int i = 0; i < 4; i++) {
        value += amplitude * noise(p);
        p = p * 2.03 + vec2(17.0, 9.0);
        amplitude *= 0.5;
    }
    return value;
}

float line(float d, float width, float aa) {
    return smoothstep(width + aa, width, abs(d));
}

float fill(float d, float aa) {
    return smoothstep(aa, -aa, d);
}

float segment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    return length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0));
}

// Distance from the middle of the nearest of count sectors, in radians.
float sector(float a, float count) {
    float size = 2.0 * PI / count;
    return abs(mod(a + size / 2.0, size) - size / 2.0);
}

float sectorId(float a, float count) {
    float size = 2.0 * PI / count;
    return mod(floor((a + size / 2.0) / size), count);
}

// Signed distance to a tapering ray; rays alternate between long and short.
float ray(vec2 q, float turn) {
    float r = length(q);
    float a = atan(q.y, q.x) + turn;
    float len = mod(sectorId(a, 24.0), 2.0) < 0.5 ? 0.27 : 0.19;
    float halfWidth = 0.019 * (1.0 - (r - SUN_RADIUS) / len);
    return max(sector(a, 24.0) * r - halfWidth, max(SUN_RADIUS - r, r - SUN_RADIUS - len));
}

vec3 pigment(float id) {
    float which = mod(id, 3.0);
    return which < 0.5 ? VERMILION : which < 1.5 ? COBALT : YELLOW;
}

// Signed distance to a teardrop with its point upward, roughly in uv units.
float drop(vec2 p) {
    float width = mix(0.016, 0.0015, smoothstep(-0.018, 0.032, p.y));
    return (length(vec2(p.x / width, (p.y - 0.004) / 0.032)) - 1.0) * 0.012;
}

float face(vec2 p, float aa, inout float eyeWhite) {
    vec2 q = vec2(abs(p.x), p.y);   // Everything but the nose is symmetric.
    float eye = (length((q - vec2(0.052, 0.03)) / vec2(0.027, 0.012)) - 1.0) * 0.012;
    eyeWhite = fill(eye, aa);
    float ink = line(eye, 0.0013, aa);
    ink += fill(length(q - vec2(0.052, 0.03)) - 0.0085, aa);
    ink += line(segment(q, vec2(0.02, 0.055), vec2(0.055, 0.066)), 0.0016, aa);
    ink += line(segment(q, vec2(0.055, 0.066), vec2(0.088, 0.05)), 0.0016, aa);
    ink += line(segment(p, vec2(0.004, 0.05), vec2(-0.012, -0.022)), 0.0014, aa);
    ink += line(segment(p, vec2(-0.012, -0.022), vec2(0.014, -0.03)), 0.0014, aa);
    ink += line(segment(q, vec2(0.0, -0.066), vec2(0.038, -0.058)), 0.0015, aa);
    float lip = length(p - vec2(0.0, -0.058)) - 0.026;
    ink += line(lip, 0.0012, aa) * step(p.y, -0.068);
    // Hatched cheeks.
    float cheek = length(q - vec2(0.076, -0.022)) - 0.022;
    ink += fill(cheek, aa) * line(fract((p.x + p.y) * 110.0) - 0.5, 0.09, 0.05) * 0.7;
    return ink;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    float aa = 1.5 / iResolution.y;
    float turn = iTime * 0.01;

    // The knife wanders a little, and the stencilled colour doesn't quite line
    // up with the block, just as on the printed cards.
    vec2 cut = (vec2(noise(uv * 14.0), noise(uv * 14.0 + 31.0)) - 0.5) * 0.004;
    vec2 p = uv + cut;
    vec2 c = uv + cut * 0.5 + vec2(0.004, -0.003);
    float mottle = clamp(0.8 + 0.4 * fbm(uv * 9.0), 0.0, 1.0);

    vec2 half_ = vec2(0.5 * iResolution.x / iResolution.y - 0.03, 0.465);
    vec2 corner = abs(p) - half_;
    float rule = max(corner.x, corner.y);
    float inside = fill(rule, aa);

    float blotch = fbm(uv * 3.0);
    float fibre = noise(vec2(uv.x * 500.0, uv.y * 35.0));
    vec3 color = mix(PAPER, AGED, smoothstep(0.55, 0.85, blotch) * 0.5);
    color *= 0.985 + 0.02 * fibre;
    color = mix(AGED, color, inside);
    float ink = 0.0;

    vec2 s = p - SUN_CENTER, sc = c - SUN_CENTER;
    float r = length(s);
    float a = atan(s.y, s.x) + turn;

    // Falling drops, kept clear of the rays.
    vec2 q = vec2(uv.x, uv.y + iTime * 0.004);
    vec2 cell = floor(q / 0.13);
    float h = hash(cell + 7.0);
    if (h > 0.45 && length(uv - SUN_CENTER) > 0.5) {
        vec2 jitter = (vec2(hash(cell + 1.0), hash(cell + 2.0)) - 0.5) * 0.05;
        vec2 local = (fract(q / 0.13) - 0.5) * 0.13 + jitter;
        float d = drop(local + cut);
        color = mix(color, pigment(floor(h * 30.0)), fill(drop(local + cut * 0.5 + vec2(0.004, -0.003)), aa) * mottle * inside);
        ink += line(d, 0.0012, aa);
    }

    // Fine black hatching radiating between the rays.
    float hatchId = sectorId(a, 180.0);
    float reach = SUN_RADIUS + 0.09 + 0.1 * hash(vec2(hatchId, 3.0));
    ink += line(sector(a, 180.0) * r, 0.0006, aa) * step(SUN_RADIUS, r) * step(r, reach) * step(0.0, ray(s, turn));

    // The rays: flat colour, a heavy outline, and a crease down the middle.
    float rayDist = ray(s, turn);
    float rayFill = fill(ray(sc, turn), aa);
    float rayId = sectorId(atan(sc.y, sc.x) + turn, 24.0);
    color = mix(color, pigment(rayId), rayFill * mottle);
    ink += line(rayDist, 0.0017, aa);
    ink += line(sector(a, 24.0) * r, 0.0006, aa) * fill(rayDist, aa);

    // The sun's disc, shaded with parallel cuts along its lower right.
    color = mix(color, YELLOW, fill(length(sc) - SUN_RADIUS, aa) * mottle);
    float disc = fill(r - SUN_RADIUS, aa);
    ink += line(r - SUN_RADIUS, 0.0022, aa) + line(r - SUN_RADIUS + 0.013, 0.0008, aa);
    float shade = disc * smoothstep(0.128, 0.136, length(s + vec2(0.03, -0.03)));
    ink += shade * line(fract((s.x - s.y) * 95.0) - 0.5, 0.12, 0.06);

    float eyeWhite;
    float faceInk = face(s, aa, eyeWhite);
    color = mix(color, PAPER, eyeWhite);
    ink += faceInk;

    // The brick wall the twins stand before, capped in vermilion.
    float wall = fill(p.y - WALL_TOP, aa) * inside;
    float wallColor = fill(c.y - WALL_TOP, aa) * inside;
    color = mix(color, YELLOW, wallColor * mottle);
    float cap = wallColor * smoothstep(WALL_TOP - 0.021, WALL_TOP - 0.019, c.y);
    color = mix(color, VERMILION, cap);
    ink *= 1.0 - wall;
    float row = floor((p.y - WALL_TOP) / 0.036);
    float courses = smoothstep(0.45, 0.48, abs(fract((p.y - WALL_TOP) / 0.036) - 0.5));
    float joints = smoothstep(0.482, 0.492, abs(fract((p.x + 0.055 * mod(row, 2.0)) / 0.11) - 0.5));
    ink += wall * clamp(courses + joints, 0.0, 1.0) * step(p.y, WALL_TOP - 0.02);
    ink += line(p.y - WALL_TOP, 0.0019, aa) * inside;
    ink += line(p.y - WALL_TOP + 0.02, 0.0012, aa) * inside;

    // Anything outside the frame is just the card's margin.
    ink *= inside;
    ink += line(rule, 0.0022, aa) + line(rule + 0.012, 0.001, aa) * fill(rule, aa);

    // Worn spots where the block didn't take the ink.
    ink *= 0.55 + 0.45 * smoothstep(0.18, 0.42, noise(uv * 110.0));
    color = mix(color, INK, clamp(ink, 0.0, 1.0));
    fragColor = vec4(color, 1.0);
}
