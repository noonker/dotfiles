# Rendered per palette.  Started through theme-lock.
image=~/.local/state/theme/current/lock.png
scaling=fill
font=%ui-font%
font-size=20
ignore-empty-password
show-failed-attempts
indicator-idle-visible
indicator-radius=86
indicator-thickness=12
inside-color=%bg%
inside-clear-color=%bg%
inside-ver-color=%bg%
inside-wrong-color=%bg%
ring-color=%fg%
ring-clear-color=%fg-dim%
ring-ver-color=%blue%
ring-wrong-color=%red%
line-color=%bg%
line-clear-color=%bg%
line-ver-color=%bg%
line-wrong-color=%bg%
key-hl-color=%accent%
bs-hl-color=%accent2%
separator-color=%bg%
text-color=%fg%
text-clear-color=%fg-dim%
text-ver-color=%blue%
text-wrong-color=%red%
