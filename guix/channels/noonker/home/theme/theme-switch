#!/bin/sh
# Switch the desktop between the day and night themes, or report the current one.
# Usage: theme-switch [day|night|light|dark|toggle|status]
# A manual switch lasts until the next sunrise, sunset or login, when darkman runs this.

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/theme
theme_dir=${XDG_CONFIG_HOME:-$HOME/.config}/theme
current=$state_dir/current
previous=$(basename "$(readlink "$current" 2>/dev/null)")

case "${1:-status}" in
    day | light) mode=day ;;
    night | dark) mode=night ;;
    toggle) if [ "$previous" = night ]; then mode=day; else mode=night; fi ;;
    status) echo "${previous:-unset}"; exit 0 ;;
    *) echo "usage: theme-switch [day|night|light|dark|toggle|status]" >&2; exit 2 ;;
esac

# Freeze the screen and crossfade to whatever is there when the delay ends, which hides
# the applications changing one by one and the shader restarting below.  Darkman also
# calls this at login, usually with nothing to change, so don't blink for that.
if [ "$mode" != "$previous" ]; then
    niri msg action do-screen-transition --delay-ms 600
fi

mkdir -p "$state_dir"
ln -sfn "$theme_dir/$mode" "$current"

# Applications that aren't running are fine: they read the pointer on startup.
if [ "$mode" = day ]; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-light
    gsettings set org.gnome.desktop.interface gtk-theme Marseille
    gsettings set org.gnome.desktop.interface cursor-theme Marseille
else
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme Arcana
    gsettings set org.gnome.desktop.interface cursor-theme Arcana
fi
. "$current/fonts.sh"
gsettings set org.gnome.desktop.interface font-name "$ui_font 11"
gsettings set org.gnome.desktop.interface document-font-name "$ui_font 11"
gsettings set org.gnome.desktop.interface monospace-font-name "$mono_font 11"
# Emacs follows these and kitty and Firefox don't.  Subpixel fringes every stem in color,
# and it's wrong at any fractional scale, since GTK 3 draws at 2x and niri scales that down.
gsettings set org.gnome.desktop.interface font-antialiasing grayscale
gsettings set org.gnome.desktop.interface font-hinting slight
# GTK doubles this for old cursor names like Emacs's and draws those itself, while niri draws
# the rest, so it has to match niri's xcursor-size or those come out half as big again.
gsettings set org.gnome.desktop.interface cursor-size 34

pkill -USR1 -x kitty
pkill -USR2 -x '\.?waybar(-real)?'
pkill -USR1 -f '/\.deck-notify-real'
niri msg action load-config-file

# The old shader stays up until the new one has had time to draw, so that there's never
# nothing there (it can take half a second to compile the first time).  Darkman also calls
# this at login, when the theme usually hasn't changed and it can just be left running.
# It's started from here, not with "niri msg action spawn", since niri ignores those while
# the screen is locked, which it may well be at sunrise and sunset.
if [ "$mode" != "$previous" ] || ! pgrep -x shaderbg >/dev/null; then
    old=$(pgrep -x shaderbg)
    setsid -f "$HOME/bin/theme-background" >/dev/null 2>&1
    if [ -n "$old" ]; then
        (sleep 0.5; kill $old) >/dev/null 2>&1 &
    fi
fi

# The change of light has a sound, unless ~/.local/state/theme/quiet exists.
if [ "$mode" != "$previous" ] && [ ! -e "$state_dir/quiet" ]; then
    pw-play "$current/chime.wav" >/dev/null 2>&1 &
fi

# Last, since a busy Emacs can take seconds, and everything else has to beat the delay.
timeout 5 emacsclient -e "(unless (bound-and-true-p im-at-work) (load \"$current/emacs.el\" nil t))" >/dev/null 2>&1
exit 0
