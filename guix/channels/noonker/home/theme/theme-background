#!/bin/sh
# Run the desktop's background shader, on the theme's own build of shaderbg (see
# noonker/packages/shaderbg.scm).  Everything a shader needs to know about the sky it now
# works out from the real clock, so this is only run again when the mode changes.
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/theme
exec "$HOME/.guix-home/profile/bin/shaderbg" --fps 15 --bake 20 '*' "$state_dir/current/background.frag"
