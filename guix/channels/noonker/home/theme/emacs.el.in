;;; -*- lexical-binding: t; -*-
;;; Generated by (noonker home theme); reloaded when the desktop theme changes.
(mapc #'disable-theme custom-enabled-themes)
(deftheme noonker-desktop "The current day or night desktop theme.")
;; As `load-theme' does; otherwise the previous mode's faces take precedence.
(put 'noonker-desktop 'theme-settings nil)
(custom-theme-set-faces
 'noonker-desktop
 '(default ((t (:background "%bg%" :foreground "%fg%"))))
 '(cursor ((t (:background "%accent%"))))
 '(fringe ((t (:background "%bg%" :foreground "%fg-dim%"))))
 '(region ((t (:background "%bg-high%" :extend t))))
 '(highlight ((t (:background "%bg-alt%"))))
 '(hl-line ((t (:background "%bg-alt%" :extend t))))
 '(secondary-selection ((t (:background "%bg-alt%" :extend t))))
 '(isearch ((t (:background "%accent%" :foreground "%bg%" :weight bold))))
 '(lazy-highlight ((t (:background "%bg-high%" :foreground "%fg%"))))
 '(match ((t (:foreground "%accent%" :weight bold))))
 '(minibuffer-prompt ((t (:foreground "%accent%" :weight bold))))
 '(link ((t (:foreground "%blue%" :underline t))))
 '(link-visited ((t (:foreground "%magenta%" :underline t))))
 '(shadow ((t (:foreground "%fg-dim%"))))
 '(error ((t (:foreground "%red%" :weight bold))))
 '(warning ((t (:foreground "%orange%" :weight bold))))
 '(success ((t (:foreground "%green%" :weight bold))))
 '(line-number ((t (:foreground "%fg-dim%"))))
 '(line-number-current-line ((t (:foreground "%accent%" :weight bold))))
 '(vertical-border ((t (:foreground "%bg-high%"))))
 '(window-divider ((t (:foreground "%bg-high%"))))
 ;; The same rule as along the bottom of waybar, over a plain strip.
 '(mode-line ((t (:background "%bg-alt%" :foreground "%fg%" :box nil :overline "%card-rule%"))))
 '(mode-line-inactive ((t (:background "%bg%" :foreground "%fg-dim%" :box nil :overline "%bg-high%"))))
 '(doom-modeline-bar-inactive ((t (:background "%bg%"))))
 '(doom-modeline-panel ((t (:background "%accent%" :foreground "%bg%"))))
 '(doom-modeline-bar ((t (:background "%accent%"))))
 '(doom-modeline-buffer-file ((t (:foreground "%accent%" :weight bold))))
 '(doom-modeline-buffer-path ((t (:foreground "%fg-dim%"))))
 '(doom-modeline-buffer-modified ((t (:foreground "%orange%" :weight bold))))
 '(doom-modeline-buffer-major-mode ((t (:foreground "%accent2%" :weight bold))))
 '(doom-modeline-buffer-minor-mode ((t (:foreground "%fg-dim%"))))
 '(doom-modeline-project-parent-dir ((t (:foreground "%fg-dim%"))))
 '(doom-modeline-project-dir ((t (:foreground "%accent2%" :weight bold))))
 '(doom-modeline-project-root-dir ((t (:foreground "%fg-dim%"))))
 '(doom-modeline-project-name ((t (:foreground "%accent2%" :weight bold))))
 '(doom-modeline-vcs-default ((t (:foreground "%fg-dim%"))))
 '(doom-modeline-emphasis ((t (:foreground "%accent%" :weight bold))))
 '(doom-modeline-highlight ((t (:foreground "%accent%"))))
 '(doom-modeline-info ((t (:foreground "%green%"))))
 '(doom-modeline-debug ((t (:foreground "%blue%"))))
 '(doom-modeline-warning ((t (:foreground "%orange%"))))
 '(doom-modeline-urgent ((t (:foreground "%red%" :weight bold))))
 '(doom-modeline-notification ((t (:foreground "%orange%"))))
 '(doom-modeline-lsp-success ((t (:foreground "%green%"))))
 '(doom-modeline-lsp-warning ((t (:foreground "%orange%"))))
 '(doom-modeline-lsp-error ((t (:foreground "%red%"))))
 '(doom-modeline-evil-normal-state ((t (:foreground "%accent%" :weight bold))))
 '(doom-modeline-evil-insert-state ((t (:foreground "%green%" :weight bold))))
 '(doom-modeline-evil-visual-state ((t (:foreground "%magenta%" :weight bold))))
 '(doom-modeline-evil-replace-state ((t (:foreground "%red%" :weight bold))))
 '(doom-modeline-evil-motion-state ((t (:foreground "%blue%" :weight bold))))
 '(doom-modeline-evil-operator-state ((t (:foreground "%cyan%" :weight bold))))
 '(doom-modeline-evil-emacs-state ((t (:foreground "%accent2%" :weight bold))))
 '(mode-line-buffer-id ((t (:foreground "%accent%" :weight bold))))
 '(header-line ((t (:background "%bg-alt%" :foreground "%fg%" :box nil))))
 '(tab-bar ((t (:background "%bg-alt%" :foreground "%fg%"))))
 '(tab-bar-tab ((t (:background "%bg-high%" :foreground "%accent%" :box nil))))
 '(tab-bar-tab-inactive ((t (:background "%bg-alt%" :foreground "%fg-dim%" :box nil))))
 '(font-lock-builtin-face ((t (:foreground "%orange%"))))
 '(font-lock-comment-face ((t (:foreground "%fg-dim%" :slant italic))))
 '(font-lock-comment-delimiter-face ((t (:foreground "%fg-dim%" :slant italic))))
 '(font-lock-constant-face ((t (:foreground "%cyan%"))))
 '(font-lock-doc-face ((t (:foreground "%green%" :slant italic))))
 '(font-lock-function-name-face ((t (:foreground "%blue%"))))
 '(font-lock-keyword-face ((t (:foreground "%magenta%"))))
 '(font-lock-negation-char-face ((t (:foreground "%red%"))))
 '(font-lock-preprocessor-face ((t (:foreground "%orange%"))))
 '(font-lock-string-face ((t (:foreground "%green%"))))
 '(font-lock-type-face ((t (:foreground "%yellow%"))))
 '(font-lock-variable-name-face ((t (:foreground "%fg%"))))
 '(font-lock-warning-face ((t (:foreground "%red%" :weight bold))))
 '(org-level-1 ((t (:foreground "%accent%" :weight bold))))
 '(org-level-2 ((t (:foreground "%blue%" :weight bold))))
 '(org-level-3 ((t (:foreground "%magenta%" :weight bold))))
 '(org-level-4 ((t (:foreground "%cyan%" :weight bold))))
 '(org-level-5 ((t (:foreground "%green%"))))
 '(org-level-6 ((t (:foreground "%orange%"))))
 '(org-level-7 ((t (:foreground "%yellow%"))))
 '(org-level-8 ((t (:foreground "%fg-dim%"))))
 '(org-block ((t (:background "%bg-alt%" :extend t))))
 '(org-block-begin-line ((t (:foreground "%fg-dim%" :extend t))))
 '(org-block-end-line ((t (:foreground "%fg-dim%" :extend t))))
 '(org-code ((t (:foreground "%orange%"))))
 '(org-verbatim ((t (:foreground "%cyan%"))))
 '(org-date ((t (:foreground "%blue%" :underline t))))
 '(org-todo ((t (:foreground "%red%" :weight bold))))
 '(org-done ((t (:foreground "%green%" :weight bold))))
 '(ansi-color-black ((t (:foreground "%black%" :background "%black%"))))
 '(ansi-color-red ((t (:foreground "%red%" :background "%red%"))))
 '(ansi-color-green ((t (:foreground "%green%" :background "%green%"))))
 '(ansi-color-yellow ((t (:foreground "%yellow%" :background "%yellow%"))))
 '(ansi-color-blue ((t (:foreground "%blue%" :background "%blue%"))))
 '(ansi-color-magenta ((t (:foreground "%magenta%" :background "%magenta%"))))
 '(ansi-color-cyan ((t (:foreground "%cyan%" :background "%cyan%"))))
 '(ansi-color-white ((t (:foreground "%white%" :background "%white%")))))
(enable-theme 'noonker-desktop)
;; Before the first frame noonker/set-fonts isn't defined yet; it applies this
;; font itself once it's called for that frame.
(defvar noonker/theme-font nil "The current desktop theme's monospace font.")
(setq noonker/theme-font "%font%")
(when (fboundp 'noonker/set-fonts)
  (let ((frame (seq-find #'display-graphic-p (frame-list))))
    (when frame (noonker/set-fonts frame))))
