+/* The source's parts in their proper order.  A #version must come before all else. */
+static GLuint compile_shader(GLenum kind, const char *version, int version_len,
+		const char *defines, const char *body, int body_len,
+		const char *coda)
+{
+	GLuint shader = glCreateShader(kind);
+	const char *parts[] = {version, defines, frag_prologue, body, coda};
+	int lengths[] = {
+			version_len,
+			(int)strlen(defines),
+			sizeof(frag_prologue) - 1,
+			body_len,
+			(int)strlen(coda),
+	};
+	glShaderSource(shader, 5, parts, lengths);
+	glCompileShader(shader);
+
+	GLint status;
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+	if (!status) {
+		char log[4096] = {0};
+		GLsizei len;
+		glGetShaderInfoLog(shader, sizeof(log), &len, log);
+		fprintf(stderr, "Failed to compile %s shader (%s): %.*s\n",
+				kind == GL_VERTEX_SHADER ? "vertex" : "fragment",
+				defines, len, log);
+		exit(EXIT_FAILURE);
+	}
+	return shader;
+}
