+/* The buffer's size follows the compositor's scale, so that one texel is one real pixel;
+ * the viewport then maps it onto the surface's logical size. */
+static void update_buffer_size(struct output *output)
+{
+	int width = (output->logical_width * (int)output->scale_120 + 60) / 120;
+	int height = (output->logical_height * (int)output->scale_120 + 60) / 120;
+	if (width != output->width || height != output->height) {
+		output->width = width;
+		output->height = height;
+		output->needs_resize = true;
+	}
+}
