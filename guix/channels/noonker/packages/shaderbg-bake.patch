+static void set_uniforms(const struct state *state, const struct uniforms *unif,
+		const struct output *output, double epoch, float mix)
+{
+	glUniform1f(unif->time, state->current_time);
+	glUniform1f(unif->time_delta, state->delta_time);
+	glUniform3f(unif->resolution, (GLfloat)output->width,
+			(GLfloat)output->height, 0.);
+	glUniform1f(unif->frame, (GLfloat)state->frame_no);
+	glUniform4f(unif->mouse, 0., 0., 0., 0.);
+	double days = (double)(int64_t)epoch;
+	glUniform2f(unif->epoch, (GLfloat)days, (GLfloat)(epoch - days));
+	glUniform1f(unif->bake_mix, mix);
+	for (int i = 0; i < 4; i++) {
+		glUniform1i(unif->channel[i], i);
+	}
+}
