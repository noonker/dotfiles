+static void bake_allocate(struct output *output)
+{
+	if (output->bake_width) {
+		glDeleteFramebuffers(2, output->bake_fbo);
+		glDeleteTextures(4, &output->bake_tex[0][0]);
+	}
+	glGenFramebuffers(2, output->bake_fbo);
+	glGenTextures(4, &output->bake_tex[0][0]);
+	static const GLenum attachments[2] = {
+			GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+	for (int pair = 0; pair < 2; pair++) {
+		glBindFramebuffer(GL_FRAMEBUFFER, output->bake_fbo[pair]);
+		for (int i = 0; i < 2; i++) {
+			glBindTexture(GL_TEXTURE_2D, output->bake_tex[pair][i]);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, output->width,
+					output->height, 0, GL_RGBA,
+					GL_UNSIGNED_BYTE, NULL);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER,
+					GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER,
+					GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S,
+					GL_MIRRORED_REPEAT);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T,
+					GL_MIRRORED_REPEAT);
+			glFramebufferTexture2D(GL_FRAMEBUFFER, attachments[i],
+					GL_TEXTURE_2D,
+					output->bake_tex[pair][i], 0);
+		}
+		glDrawBuffers(2, attachments);
+		if (glCheckFramebufferStatus(GL_FRAMEBUFFER) !=
+				GL_FRAMEBUFFER_COMPLETE) {
+			fprintf(stderr, "Bake framebuffer is incomplete\n");
+			exit(EXIT_FAILURE);
+		}
+	}
+	output->bake_width = output->width;
+	output->bake_height = output->height;
+}
+
+/* Bake some of a new image, if one is due.  The first, or the first after a resize,
+ * goes in one piece, as there's nothing yet to show in the meantime. */
+static void bake_step(struct output *output)
+{
+	struct state *state = output->state;
+	bool whole = output->bake_width != output->width ||
+		     output->bake_height != output->height;
+	if (whole) {
+		bake_allocate(output);
+		output->bake_current = 1;
+		output->bake_tile = 0;
+	} else if (output->bake_tile < 0) {
+		if (state->current_time < output->bake_next) {
+			return;
+		}
+		output->bake_tile = 0;
+	}
+	int target = 1 - output->bake_current;
+	if (output->bake_tile == 0) {
+		output->bake_epoch[target] = epoch_now();
+	}
+
+	glBindFramebuffer(GL_FRAMEBUFFER, output->bake_fbo[target]);
+	glUseProgram(state->bake_prog);
+	set_uniforms(state, &state->bake_unif, output, output->bake_epoch[target], 1.f);
+	glDisable(GL_BLEND);
+	if (whole) {
+		glDrawArrays(GL_TRIANGLE_FAN, 0, 3);
+		output->bake_tile = BAKE_TILES;
+	} else {
+		int row = output->bake_tile;
+		int y0 = output->height * row / BAKE_TILES;
+		int y1 = output->height * (row + 1) / BAKE_TILES;
+		glEnable(GL_SCISSOR_TEST);
+		glScissor(0, y0, output->width, y1 - y0);
+		glDrawArrays(GL_TRIANGLE_FAN, 0, 3);
+		glDisable(GL_SCISSOR_TEST);
+		output->bake_tile++;
+	}
+
+	if (output->bake_tile == BAKE_TILES) {
+		output->bake_current = target;
+		output->bake_tile = -1;
+		output->bake_fade_start =
+				whole ? state->current_time - 1000.f
+				      : state->current_time;
+		output->bake_next = state->current_time + state->bake_interval;
+	}
+}
