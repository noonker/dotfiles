+/* Days since J2000 UTC.  A shader's floats can't hold this, so it gets it in two parts. */
+static double epoch_now(void)
+{
+	struct timespec now;
+	clock_gettime(CLOCK_REALTIME, &now);
+	const int64_t j2000 = 946728000; // 2000-01-01 12:00 UTC
+	return ((double)((int64_t)now.tv_sec - j2000) + 1e-9 * (double)now.tv_nsec) /
+	       86400.;
+}
