#!/usr/bin/env bash
# ~/.local/bin/bookmark-search

bookmarks=$(emacsclient -e '(noonker/json-bookmarks)' | jq -r . | jq -r '
  .[] | "\(.[0]) / \(.[1]) - \(.[3]) | \(.[2])"
')

selected=$(echo "$bookmarks" | rofi -dmenu -i -p "🔖 Bookmarks" -matching normal -sort -sorting-method fzf)

if [ -n "$selected" ]; then
  url=$(echo "$selected" | sed 's/.*| //')
  xdg-open "$url"
fi